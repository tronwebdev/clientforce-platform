// Clientforce Platform — Prisma schema (DATA_MODEL.md §1–§7).
//
// Conventions (DATA_MODEL.md): ids are cuid(); money & credits are integer minor
// units; createdAt/updatedAt on every model; Postgres enums. Every tenant-scoped
// table carries `workspaceId` and is protected by Postgres RLS (see the
// migration `*_rls_policies`). Agency-level rows are keyed by `agencyId` instead
// and are not workspace-scoped.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────────────────────────────────────────────────────────
// §1 Tenancy — the 3-level white-label hierarchy (Agency → Workspace → User)
// ─────────────────────────────────────────────────────────────────────────────

model Agency {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  branding         Json
  planTier         AgencyPlan   @default(GROWTH)
  status           TenantStatus @default(ACTIVE)
  stripeCustomerId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  workspaces       Workspace[]
  plans            Plan[]
  creditPrices     CreditPrice[]
}

model Workspace {
  id            String       @id @default(cuid())
  agencyId      String
  agency        Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  // Immutable Clerk Organization id — the auth layer resolves the active
  // workspace by this (not by slug). Set at provisioning time (T7).
  clerkOrgId    String?      @unique
  status        TenantStatus @default(ACTIVE)
  branding      Json?
  planId        String?
  creditBalance Int          @default(0)
  settings      Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]

  @@unique([agencyId, slug])
  @@index([agencyId])
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  authProviderId String?      @unique
  /// B9 (DEC-136, tour addendum): per-USER preferences — tour-seen and
  /// friends persist with the account, never a browser (additive Json).
  settings       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  memberships    Membership[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(AGENT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

enum AgencyPlan {
  STARTER
  GROWTH
  SCALE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum Role {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

// ─────────────────────────────────────────────────────────────────────────────
// §2 Knowledge & business context (pgvector)
// ─────────────────────────────────────────────────────────────────────────────

model KnowledgeSource {
  id          String           @id @default(cuid())
  workspaceId String
  agentId     String?
  kind        SourceKind
  uri         String?
  label       String
  status      IngestStatus     @default(PENDING)
  meta        Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  chunks      KnowledgeChunk[]

  @@index([workspaceId])
}

model KnowledgeChunk {
  id          String          @id @default(cuid())
  workspaceId String
  sourceId    String
  content     String
  // P1.2: 1536-dim (text-embedding-3-large, dimensions=1536 via @clientforce/ai)
  // with an hnsw cosine index — resolves T1's TODO(phase-1).
  embedding   Unsupported("vector(1536)")
  tokens      Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  source      KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceId])
}

// P1.3 (DEC-024/025): two-layer context — one row per agent PLUS one
// workspace-layer row (agentId null, Brand kit). Uniqueness is enforced by
// partial unique indexes in the migration (Prisma can't express them):
// UNIQUE(agentId) WHERE agentId IS NOT NULL · UNIQUE(workspaceId) WHERE agentId IS NULL.
// `fields` is the registry-keyed map { value, citations: chunkId[], source }.
model BusinessContext {
  id          String        @id @default(cuid())
  workspaceId String
  agentId     String?
  goal        String?
  status      ContextStatus @default(READY)
  fields       Json          @default("{}")
  // Custom-goal distiller-proposed asks: [{ key, ask, dismissed? }] (DEC-024).
  proposedAsks Json          @default("[]")
  rawSummary   String        @default("")
  distilledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  agent       Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([agentId])
}

enum ContextStatus {
  DISTILLING
  READY
}

enum SourceKind {
  WEBSITE
  DOCUMENT
  CONNECTOR
  TEXT
}

enum IngestStatus {
  PENDING
  INGESTING
  READY
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// §3 Agents, campaigns & the Campaign Graph
// ─────────────────────────────────────────────────────────────────────────────

model Agent {
  id              String           @id @default(cuid())
  workspaceId     String
  name            String
  goal            String
  category        String?
  instructions    String?
  status          AgentStatus      @default(DRAFT)
  guardrails      Json
  /// B6: wizard draft-resume working set (core `draftStateSchema`); NULL once launched.
  draftState      Json?
  /// B1 (DEC-104, Addendum-2 §D): campaign value model — owner-editable in the
  /// Bold overview strip. All nullable; money renders only once set (honest absence).
  valueEstCents       Int?
  valueGoalUnits      Int?
  valueSalesGoalCents Int?
  /// B2.5 (DEC-109, Q-069): the guided-create goal sentence (hero/list lead);
  /// null on legacy rows — goalSentence() falls back to free text / the brief.
  goalSummary         String?
  /// B2.6 (DEC-110, Q-066): the Ada-suggestion marker (core agentSuggestionSchema);
  /// null = owner-created. Dismissal stamps dismissedAt inside the Json — the
  /// row stays so the signal never re-suggests.
  suggestion          Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  campaigns        Campaign[]
  businessContexts BusinessContext[]

  @@index([workspaceId])
}

model Campaign {
  id          String          @id @default(cuid())
  workspaceId String
  agentId     String
  name        String
  graphId     String
  status      CampaignStatus  @default(ACTIVE)
  /// LH1 (DEC-087): per-day-per-campaign enrollment cap — bounds the QUEUE
  /// feeding the send caps (effective send volume stays min(warmup curve,
  /// dailyLimit) — untouched). null = the platform default constant
  /// (`ENROLLMENT_DAILY_CAP_DEFAULT`); enforced at the enrollment gate for
  /// EVERY source. Default ON; owner-flippable per campaign.
  enrollmentDailyCap   Int?
  enrollmentCapEnabled Boolean @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  agent       Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  graphs      CampaignGraph[]
  enrollments Enrollment[]
  rules       CampaignRule[]
  threadStates ThreadState[]

  @@index([workspaceId])
  @@index([agentId])
}

model CampaignGraph {
  id          String      @id @default(cuid())
  workspaceId String
  campaignId  String
  version     Int
  graph       Json
  source      GraphSource @default(AI)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, version])
  @@index([workspaceId])
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum GraphSource {
  AI
  TEMPLATE
  MANUAL
}

// ─────────────────────────────────────────────────────────────────────────────
// §4 Leads, enrollment & pipeline
// ─────────────────────────────────────────────────────────────────────────────

/// C2.7: workspace-defined custom field (docs/PLAN_CUSTOM_FIELDS.md). `key` is
/// an immutable slug; archive-never-delete (values stay in Contact.custom).
model ContactFieldDef {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  label       String
  type        FieldType @default(TEXT)
  options     String[]
  origin      String
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

model Contact {
  id          String           @id @default(cuid())
  workspaceId String
  email       String?
  phone       String?
  firstName   String?
  lastName    String?
  company     String?
  title       String?
  source      String
  enrichment  Json?
  /// C2.7: user-entered custom-field values keyed by ContactFieldDef.key —
  /// never mixed with `enrichment` (reserved for machine enrichment).
  custom      Json             @default("{}")
  tags        String[]
  /// B3a review (DEC-112(7)): the owner's free-text note on a person.
  /// Written from the contact detail; Ada's compose-time read of it is
  /// B3b+ scope (Q-079).
  notes       String?
  /// B3c-1 (DEC-118(2)): call consent — granted | denied | unknown. The
  /// column defaults unknown, and unknown = Ada may NOT place an automated
  /// call (human-placed calls key off DNC/opt-out instead, B3c-2). Every
  /// flip lands provenance on the timeline.
  callConsent String    @default("unknown")
  /// B3c-1 (DEC-118): the contact-local quiet-hours source — IANA zone,
  /// written when a calendar booking carries one; absent → the dial rail
  /// falls back to the campaign window's zone and says so.
  timezone    String?
  optOut      Json
  /// LH1 (DEC-087): email-validation verdict — valid | risky | invalid |
  /// unverified (default; `EMAIL_VERDICTS` in @clientforce/core is the
  /// enum of record). The enrollment gate reads this. The suppression
  /// ledger stays authoritative: a verdict NEVER un-suppresses.
  emailVerdict          String    @default("unverified")
  emailVerdictCheckedAt DateTime?
  /// zerobounce | cache | syntax | mx — which pass produced the verdict.
  emailVerdictSource    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lists       ContactListMember[]
  enrollments Enrollment[]
  events      Event[]

  @@index([workspaceId, email])
  @@index([workspaceId, phone])
  @@index([workspaceId, emailVerdict])
}

model Enrollment {
  id            String           @id @default(cuid())
  workspaceId   String
  campaignId    String
  contactId     String
  workflowId    String           @unique
  pipelineStage String
  currentNode   String?
  status        EnrollmentStatus @default(ACTIVE)
  // P1.6: user-visible run audit — send-boundary refusals ({blocked}), intended
  // actions, branch routing. The Logs tab renders refusals as amber rows.
  meta          Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  campaign      Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact       Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  replyHolds    EnrollmentReplyHold[]

  @@unique([campaignId, contactId])
  @@index([workspaceId])
}

model PipelineStage {
  id          String   @id @default(cuid())
  workspaceId String
  campaignId  String?
  key         String
  label       String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

model ContactList {
  id          String              @id @default(cuid())
  workspaceId String
  name        String
  /// C2.8 (docs/PLAN_CONTACT_LISTS.md): "manual" | "csv_import" | "form" |
  /// "widget" | "automation" — future origins RESERVED for the integrations.
  origin      String
  /// Archive, never delete (same rule as ContactFieldDef).
  archived    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     ContactListMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// C2.8: explicit membership (lists ≠ segments — segments stay derived).
/// The plan's composite identity lives in @@unique([listId, contactId]); the
/// surrogate id is retained from the Phase-0 table (no FK churn), and
/// workspaceId stays for the house RLS pattern.
model ContactListMember {
  id          String      @id @default(cuid())
  workspaceId String
  listId      String
  contactId   String
  addedAt     DateTime    @default(now())
  /// userId | "import" | "automation"
  addedBy     String
  list        ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([workspaceId])
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  DONE
  UNSUBSCRIBED
  BOUNCED
}

/// LH1 (DEC-087): workspace-scoped verdict cache — one row per normalized
/// address; re-imports/re-enrolls inside the TTL (~90d) never re-bill the
/// provider. `billedAt` is the COGS meter: set only when a PAID provider
/// call produced the verdict (free-filter verdicts carry billedAt = null),
/// so allowance/ceiling/usage counts are one indexed count away.
model EmailValidationVerdict {
  id          String    @id @default(cuid())
  workspaceId String
  /// Lowercased, trimmed address — the cache key.
  address     String
  /// valid | risky | invalid (an unknown-yet address simply has no row).
  verdict     String
  /// Provider sub-status (e.g. "mailbox_not_found") — report row detail.
  subStatus   String?
  /// zerobounce | syntax | mx — which pass wrote it.
  source      String
  checkedAt   DateTime  @default(now())
  expiresAt   DateTime
  billedAt    DateTime?
  costMicros  Int       @default(0)

  @@unique([workspaceId, address])
  @@index([workspaceId, billedAt])
  @@index([billedAt])
}

/// LH1 (DEC-087): one async validation run (a CSV import, a single add).
/// Validation NEVER blocks a flow — batches carry honest progress and honest
/// holds (allowance / spend ceiling / provider down), and the report reads
/// item outcomes progressively as chunks return.
model ValidationBatch {
  id          String                @id @default(cuid())
  workspaceId String
  /// Client idempotency key (the web import flow's uuid) — every chunk of
  /// one import lands on ONE batch.
  clientKey   String?
  /// csv_import | manual | single
  source      String
  /// queued | running | held | completed
  status      String                @default("queued")
  /// workspace_allowance | platform_spend_ceiling | provider_unavailable
  heldReason  String?
  listId      String?
  /// Optimistic chunk-claim lease — a second worker turn on the same batch
  /// skips instead of double-billing the provider.
  claimedUntil DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  completedAt DateTime?
  items       ValidationBatchItem[]

  @@unique([workspaceId, clientKey])
  @@index([workspaceId, status])
}

model ValidationBatchItem {
  id          String          @id @default(cuid())
  workspaceId String
  batchId     String
  contactId   String
  address     String
  /// pending | valid | risky | invalid | skipped_suppressed
  outcome     String          @default("pending")
  /// zerobounce | cache | syntax | mx | suppression
  via         String?
  detail      String?
  billed      Boolean         @default(false)
  updatedAt   DateTime        @updatedAt
  batch       ValidationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, contactId])
  @@index([workspaceId])
  @@index([batchId, outcome])
}

/// LH1 (DEC-087): the enrollment gate's hold queue — a persisted INTENT to
/// enroll that drains progressively as verdicts return and the daily cap
/// frees. A hold owns no workflow; it becomes an Enrollment only back
/// through the gate. Reasons: unverified (validation pending) · risky_held
/// (workspace policy, default hold) · cap_overflow (drains next day).
model EnrollmentHold {
  id           String   @id @default(cuid())
  workspaceId  String
  campaignId   String
  agentId      String
  contactId    String
  senderId     String?
  origin       Json?
  reason       String
  /// pending | released | refused
  status       String   @default("pending")
  /// Typed refusal code when refused (CONTACT_INVALID).
  refusalCode  String?
  /// The Enrollment created when this hold released.
  enrollmentId String?
  requestedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([campaignId, contactId])
  @@index([workspaceId, status])
  @@index([campaignId, status])
}

/// B3b (DEC-117, owner ruling): a HUMAN REPLY pauses Ada for that contact's
/// enrollment until the explicit Resume control clears it — no auto-resume
/// timer. Named EnrollmentReplyHold because `EnrollmentHold` above is LH1's
/// PRE-enrollment validation hold (a different lifecycle). Released rows keep
/// their stamps; active = releasedAt null. The send boundary refuses step
/// sends against an active hold; human replies pass.
/// B3d (DEC-122): ONE approval spine for everything that waits on a human
/// tap — level-1 step parks now; budget/branch actions when their emitters
/// exist. Derived queue items (campaign proposals = Agent.suggestion rows,
/// needs-reply threads) are NOT duplicated here — the queue assembler reads
/// them live; this table holds only items whose WAIT is its own state.
model Approval {
  id           String    @id @default(cuid())
  workspaceId  String
  campaignId   String
  agentId      String
  enrollmentId String?
  contactId    String?
  /// step_send | step_call | budget_move | branch_start (typed vocabulary;
  /// reply drafts + proposals are derived, never rows)
  kind         String
  /// PENDING | APPROVED | DISMISSED
  status       String    @default("PENDING")
  /// The provenance line the queue renders — factual, human-readable.
  reason       String
  /// stepNodeId, channel, scheduled copy refs — kind-shaped.
  meta         Json?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([enrollmentId, status])
  @@index([workspaceId, campaignId, status])
  @@index([workspaceId, status, createdAt])
}

model EnrollmentReplyHold {
  id           String     @id @default(cuid())
  workspaceId  String
  enrollmentId String
  campaignId   String
  contactId    String
  reason       String     @default("human_reply")
  createdById  String?
  createdAt    DateTime   @default(now())
  releasedById String?
  releasedAt   DateTime?
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, releasedAt])
  @@index([workspaceId, contactId, releasedAt])
}

/// B3b (DEC-117): per-thread working state — threads are (campaign, contact)
/// with no Thread table (B2), so assign + snooze live here. Additive; the
/// inbox assembler joins it.
model ThreadState {
  id             String    @id @default(cuid())
  workspaceId    String
  campaignId     String
  contactId      String
  assigneeUserId String?
  snoozedUntil   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// §5 Events — the immutable backbone
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id           String   @id @default(cuid())
  workspaceId  String
  type         String
  contactId    String?
  enrollmentId String?
  campaignId   String?
  /// P5 W1 (DEC-083): sender attribution (backfilled via payload.messageId →
  /// Message) — the health engine's per-sender window rollup is one index scan.
  senderId     String?
  payload      Json
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type, occurredAt])
  @@index([enrollmentId])
  // F1 (DEC-068): the outcomes rollup filters campaign + type set per request.
  @@index([workspaceId, campaignId, type])
  // P5 W1 (DEC-083): the health window rollup (sender + type set + window).
  @@index([workspaceId, senderId, type, occurredAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// §6 Automations, integrations, channels
// ─────────────────────────────────────────────────────────────────────────────

model Automation {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  enabled     Boolean         @default(true)
  trigger     Json
  conditions  Json
  actions     Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  runs        AutomationRun[]

  @@index([workspaceId])
}

model AutomationRun {
  id           String     @id @default(cuid())
  workspaceId  String
  automationId String
  /// R1-UI (DEC-091, additive): the bus Event row id (or the sweep's synthetic
  /// fire-once key `quiet:<enrollmentId>`) for DIRECT account-rule fires —
  /// unique (automationId, eventId) = redelivery idempotency, the
  /// CampaignRuleRun pattern. NULL on nested `run_automation` rows (their
  /// idempotency lives in the outer rule's (ruleId, eventId) key) and on
  /// pre-DEC-091 history.
  eventId      String?
  status       String
  detail       Json
  ranAt        DateTime   @default(now())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, eventId])
  @@index([workspaceId])
  @@index([automationId])
}

/// R1 (DEC-074): per-agent automation rules (ARCHITECTURE §151) — the
/// campaign-scoped SIBLING of the standalone `Automation` (§152, Phase 6),
/// sharing the typed trigger/condition/action unions in `@clientforce/core`
/// but a DISTINCT entity: rules carry row order, goal-seed provenance,
/// wizard-draft lifecycle, and the graph interlock (terminal-action skip) —
/// none of which exists for account automations.
model CampaignRule {
  id          String            @id @default(cuid())
  workspaceId String
  campaignId  String
  /// Evaluation order — ascending; first terminal action wins conflicts.
  order       Int
  trigger     Json
  condition   Json?
  actions     Json
  enabled     Boolean           @default(true)
  /// Goal-seed provenance (W2) — seeds are rows like any other.
  seededFrom  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  runs        CampaignRuleRun[]

  @@index([workspaceId])
  @@index([campaignId])
}

/// R1 (DEC-074): rule-run history, mirroring `AutomationRun`'s shape.
/// Idempotency: unique (ruleId, eventId) — bus redelivery can't double-fire
/// (eventId is the bus Event row id, or the sweep's synthetic fire-once key
/// `quiet:<enrollmentId>` for the timer trigger).
model CampaignRuleRun {
  id           String       @id @default(cuid())
  workspaceId  String
  ruleId       String
  enrollmentId String?
  contactId    String?
  eventId      String
  status       String
  detail       Json
  /// Causation depth (rule → run automation → …); evaluator refuses > 2.
  depth        Int          @default(0)
  ranAt        DateTime     @default(now())
  rule         CampaignRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, eventId])
  @@index([workspaceId])
  @@index([ruleId])
}

// INT W1 (DEC-093): the ONE connection model — one row per (workspace,
// provider), status PROBE-BACKED (connected | unhealthy | revoked — never
// "connected" without a live token probe; user disconnect DELETES the row,
// the ledger keeps the audit). Tokens live ONLY in credentialsEnc
// (AES-256-GCM under FIELD-ENCRYPTION-KEY — the SenderConnection/DEC-030
// rule; the pre-W1 `credentials Json` column is retired in place, additive
// schema: new code never reads or writes it).
model Integration {
  id            String   @id @default(cuid())
  workspaceId   String
  provider      String
  status        String   @default("connected")
  credentials   Json     @default("{}")
  config        Json
  /// Field-encrypted vendor tokens ({ accessToken, ... } per adapter).
  credentialsEnc Bytes?
  /// Vendor-side account display ("BrightPath workspace") — probe-sourced.
  accountLabel  String?
  /// Scopes the vendor actually GRANTED at the token exchange (drawer list).
  scopes        String[] @default([])
  lastProbeAt   DateTime?
  /// Newest successful outbound delivery/sync — the drawer "Last sync".
  lastSyncAt    DateTime?
  connectedById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deliveries IntegrationDelivery[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

// INT W1 (DEC-093): one row per outbound integration delivery attempt (Slack
// post now; webhook POST in W3) — the drawer audit trail + the redelivery
// idempotency ledger. Unique (integrationId, sourceEventId, kind) dedupes bus
// redeliveries (Postgres NULLs are distinct, so manual test deliveries with a
// NULL source never collide).
/// INT W5 (DEC-101): a workspace-scoped API key — v1 auth for the Zapier
/// private app (owner ruling: key, not OAuth). The SECRET IS NEVER STORED.
/// `prefix` is the public half used to look the row up; `hash` is SHA-256 of
/// the full token, compared in constant time. A lost key is re-minted, never
/// recovered. Revocation is a timestamp, so an audit trail outlives the key.
model WorkspaceApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  /// Human label ("Zapier"), shown in Settings so a workspace can tell keys apart.
  name        String
  /// Public lookup half of the token — safe to display and to log.
  prefix      String    @unique
  /// SHA-256 of the WHOLE token. Never the token, never reversible.
  hash        String
  /// Coarse (per-use) touch, so an unused key is visibly stale before revoking.
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, revokedAt])
}

model IntegrationDelivery {
  id            String   @id @default(cuid())
  workspaceId   String
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// The catalog Event row that caused this delivery (NULL for manual tests).
  sourceEventId String?
  /// new_reply | meeting_booked | goal_completed | notify_team (W1).
  kind          String
  /// pending (claimed pre-send — the at-most-once rail) | delivered | failed | held
  status        String
  detail        Json?
  createdAt     DateTime @default(now())

  @@unique([integrationId, sourceEventId, kind])
  @@index([workspaceId, createdAt])
}

// INT W2 (DEC-094): one row per detected booking — the CURRENT state of a
// meeting (reschedules update startAt, cancels flip status) + the
// before_meeting sweep anchor. Bookings arrive via provider webhooks
// (Calendly detection tier now; more providers later); unique
// (workspaceId, provider, externalId) = webhook redelivery idempotency.
// contactId NULL = an invitee we could not correlate (honest "not our lead").
model Meeting {
  id           String    @id @default(cuid())
  workspaceId  String
  contactId    String?
  enrollmentId String?
  campaignId   String?
  provider     String
  externalId   String
  /// booked | canceled | no_show
  status       String    @default("booked")
  title        String?
  startAt      DateTime
  endAt        DateTime?
  timezone     String?
  inviteeEmail String?
  rescheduleUrl String?
  cancelUrl    String?
  meta         Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, status, startAt])
  @@index([workspaceId])
}

// P1.5: the three-tier sender model (issue P1.5; replaces the T1 `Sender`
// placeholder — DEC-030). Per-tenant credentials live ONLY in credentialsEnc
// (AES-256-GCM under the FIELD-ENCRYPTION-KEY master key); CF_MANAGED shared
// pool carries none. warmupState/dedicatedIp/ipPoolId/subuser are reserved so
// later tiers are additive (DEC-019).
model SenderConnection {
  id               String       @id @default(cuid())
  workspaceId      String
  type             SenderType
  fromEmail        String
  // Owner rule 1 (2026-07-04): a send through a sender without a from-name
  // FAILS at the boundary — the signature merge token must never render blank.
  fromName         String?
  replyTo          String?
  status           SenderStatus @default(ACTIVE)
  domainAuthStatus Json         @default("{}")
  dailyLimit       Int          @default(200)
  sendingWindow    Json?
  credentialsEnc   Bytes?
  warmupState      Json?
  dedicatedIp      String?
  ipPoolId         String?
  subuser          String?
  /// P5 W1 (DEC-083): deterministic health snapshot ({ v, score, state, floor,
  /// sample, rates, computedAt }) — written by the worker sweep + webhook fast
  /// path from ledger aggregates; the send boundary reads `state` only.
  healthState      Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([workspaceId])
}

enum SenderType {
  CF_MANAGED
  GMAIL_OAUTH
  OUTLOOK_OAUTH
  SMTP
  /// P2.1 (DEC-061): Twilio SMS — phone rides the fromEmail column (enum-only
  /// migration); messagingServiceSid rides credentialsEnc (field-encrypted).
  TWILIO_SMS
}

enum SenderStatus {
  ACTIVE
  PAUSED
  DISABLED
}

// P1.5 (handoff A6): every outbound persisted AS RENDERED at send time;
// P1.7 persists every inbound + its classified intent.
model Message {
  id                String           @id @default(cuid())
  workspaceId       String
  campaignId        String
  enrollmentId      String?
  contactId         String
  channel           String
  direction         MessageDirection
  subject           String?
  body              String
  providerMessageId String?          @unique
  inReplyToId       String?
  intent            String?
  stepNodeId        String?
  /// P5 W1 (DEC-083): sender attribution as a real column (backfilled from
  /// meta.senderId, which stays for compat) — warmup caps + health rollups.
  senderId          String?
  sentAt            DateTime
  meta              Json?

  @@index([workspaceId, contactId, sentAt])
  @@index([workspaceId, campaignId, sentAt])
  @@index([workspaceId, senderId, channel, sentAt])
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

// P3.1 (DEC-078): one row per phone call — the Calls tab's backing data.
// Transcript turns live on Message(channel:"voice") rows carrying
// meta.callId (the spike-proven mapping, no Message change); this row holds
// the call-level facts: status/outcome, duration, cost, and the disclosure
// record. `providerCallSid` is the idempotency key against Twilio callbacks.
// No FK constraints — Message-style loose references + indexes.
model Call {
  id              String     @id @default(cuid())
  workspaceId     String
  campaignId      String
  agentId         String
  contactId       String
  enrollmentId    String?
  /// B3c-1 (DEC-113/118): who placed the call — "ada" (automated; consent
  /// gate applies) or "human" (B3c-2's browser-mic leg; DNC gate applies).
  caller          String     @default("ada")
  /// The user who clicked (drawer dials); null for campaign-step dials.
  placedById      String?
  direction       MessageDirection
  status          CallStatus @default(QUEUED)
  /// Deterministic call-status outcome (D4): completed | no_answer | busy |
  /// failed | canceled. Richer lead outcomes arrive with call tools (P3.2+).
  outcome         String?
  providerCallSid String?    @unique
  startedAt       DateTime?
  endedAt         DateTime?
  durationSec     Int?
  /// Estimated cost, logging-grade (gateway precedent — never billing).
  costUsd         Float?
  /// disclosureVariant/disclosureCompleted/spokenNameSource, endpointing
  /// params, per-leg cost breakdown, turn counts.
  meta            Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([workspaceId, agentId, createdAt])
  @@index([workspaceId, contactId, createdAt])
}

enum CallStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// SPEC A (DEC-099): one row per mid-call context lookup — the RECEIPT for
/// `lookup_contact_context`. The agent answers a caller's question from the
/// record, so the record must show what it actually read before it spoke:
/// which facet, the question in its own words, whether anything was found,
/// and which rows grounded the answer. A turn with no receipt was answered
/// from the brief alone — that absence is itself the audit signal.
///
/// Append-only (the CreditLedger stance — enforced in code, no UPDATE path).
/// `found: false` rows are kept deliberately: an honest "I don't have that on
/// record" is only provable if the empty lookup left a trace.
/// Loose `callId` reference with no FK, matching `Call` itself.
model CallRetrieval {
  id          String   @id @default(cuid())
  workspaceId String
  callId      String
  contactId   String
  /// 1-based caller turn this lookup served (0 = before any turn).
  turn        Int
  /// Order within the call — receipts render in this order; with `callId` it
  /// is also the idempotency key for a retried flush.
  seq         Int
  /// RECALL_FACETS in @clientforce/core is the enum of record.
  facet       String
  /// The model's own phrasing of what it was looking for — verbatim.
  query       String
  found       Boolean
  itemCount   Int
  latencyMs   Int
  /// Typed refusal (RECALL_REFUSAL_REASONS) when the lookup could not run —
  /// budget, timeout, store failure. Null on a completed lookup.
  refusalReason String?
  /// Provenance ids/labels of what was read — never the retrieved bodies
  /// (those are already in the stores this points at).
  sources     Json     @default("[]")
  createdAt   DateTime @default(now())

  @@unique([callId, seq])
  @@index([workspaceId, callId, seq])
}

// P1.5 (handoff A7): checked at the send boundary together with
