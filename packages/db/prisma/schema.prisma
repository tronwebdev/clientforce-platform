  id            String    @id @default(cuid())
  workspaceId   String
  proposalId    String
  contactId     String
  channel       String
  trackedLinkId String    @unique
  viewedAt      DateTime?
  acceptedAt    DateTime?
  paidAt        DateTime?
  amount        Int?
  createdAt     DateTime  @default(now())
  proposal      Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)

